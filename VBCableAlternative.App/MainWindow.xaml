<Window x:Class="VBCableAlternative.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VBCableAlternative.App"
        mc:Ignorable="d"
        Title="VB-CABLE Prototype" Height="640" Width="980">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="VB-CABLE Prototype" FontSize="28" FontWeight="Bold" />
            <TextBlock Text="CABLE Input is the playback endpoint; CABLE Output is the recording endpoint. This prototype does not install an audio driver." Foreground="#4B5563" FontSize="14" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <ItemsControl x:Name="CableList" ItemsSource="{Binding Routes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="10" Margin="0,0,0,12" Padding="16" Background="#F9FAFB">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Summary}" Foreground="#4B5563" Margin="0,4,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="12,0">
                                    <TextBlock Text="Playback device" FontWeight="SemiBold" />
                                    <ComboBox ItemsSource="{Binding DataContext.InputDevices, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding InputDevice}" Margin="0,6,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="12,0">
                                    <TextBlock Text="Recording device" FontWeight="SemiBold" />
                                    <ComboBox ItemsSource="{Binding DataContext.OutputDevices, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding OutputDevice}" Margin="0,6,0,0" />
                                </StackPanel>

                                <CheckBox Grid.Column="3" IsChecked="{Binding Enabled}" Content="Enabled" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Refresh devices" Width="120" Margin="0,0,12,0" Click="RefreshButton_Click" />
            <Button Content="Exit" Width="80" Click="ButtonExit_Click" />
        </StackPanel>
    </Grid>
</Window>
