<Window x:Class="VBCableAlternative.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Virtual Cable Manager" Height="470" Width="760"
        MinHeight="430" MinWidth="680" WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="Virtual Cable Manager" FontSize="26" FontWeight="Bold" />
            <TextBlock Text="Manage the four Windows playback and recording endpoint pairs."
                       Foreground="#4B5563" FontSize="14" Margin="0,5,0,0" />
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6"
                Background="#F8FAFC" Padding="12" Margin="0,0,0,16">
            <DockPanel>
                <Ellipse x:Name="StatusIndicator" Width="10" Height="10" Fill="#94A3B8"
                         VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock x:Name="StatusText" Text="Checking driver status..."
                           FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <DataGrid Grid.Row="2" x:Name="EndpointGrid" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  SelectionMode="Single" RowHeight="38">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Cable" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Playback" Binding="{Binding Input}" Width="2*" />
                <DataGridTextColumn Header="Recording" Binding="{Binding Output}" Width="2*" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="3" Margin="0,18,0,0">
            <TextBlock x:Name="NoticeText" Text="Test-signed driver. Use only on a test PC."
                       Foreground="#64748B" VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="RefreshButton" Content="Refresh" MinWidth="84" Padding="12,7"
                        Margin="0,0,8,0" Click="RefreshButton_Click" />
                <Button x:Name="InstallButton" Content="Install driver" MinWidth="112"
                        Padding="12,7" Margin="0,0,8,0" Click="InstallButton_Click" />
                <Button x:Name="UninstallButton" Content="Uninstall" MinWidth="96"
                        Padding="12,7" Click="UninstallButton_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>